# Copy to .env and fill in. Never commit the real .env file.

# --- Mongo ---
MONGO_URI=mongodb://localhost:27017/CHANGEME

# --- CORS: the origin your frontend is served from ---
CORS_ORIGINS=http://localhost:5173

# --- Local image storage (profile: local) ---
LOCAL_IMAGE_ROOT=../local-images
LOCAL_IMAGE_PREFIX=/images

# --- DigitalOcean Spaces (profile: prod) ---
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_REGION=nyc3
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=
# CDN base for the Space, e.g. https://your-space.nyc3.cdn.digitaloceanspaces.com
SPACES_CDN_BASE=

# --- Mail notifications ---
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_NOTIFY_TO=
MAIL_NOTIFY_FROM=
